<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wallpaper"
    android:orientation="vertical">

    <!-- 顶部导航 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/pay_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_speed"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/action_back"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/pay_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pay_qq"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_speed"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/pay_qq_button"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- TV / 触屏横屏：左右两栏；触屏竖屏：上下排列（代码切换） -->
        <LinearLayout
            android:id="@+id/pay_columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- 左栏：会员档位 + 支付方式 -->
            <LinearLayout
                android:id="@+id/pay_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/pay_tier_title"
                    android:textColor="#DDFFFFFF"
                    android:textSize="14sp" />

                <!-- 会员档位（代码两列填充） -->
                <LinearLayout
                    android:id="@+id/pay_tiers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/pay_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="start"
                    android:textColor="@color/accent"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- 支付方式切换 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pay_method_wechat"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_method_focus"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/pay_method_wechat"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/pay_method_alipay"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_method_focus"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/pay_method_alipay"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右栏：支付二维码 + 订单/激活 -->
            <LinearLayout
                android:id="@+id/pay_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp">

                <TextView
                    android:id="@+id/pay_qr_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="#DDFFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/pay_qr_image"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/white"
                    android:contentDescription="@string/pay_title"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pay_qr_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/pay_qr_pending"
                    android:textColor="@color/hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/pay_after_pay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/pay_after_pay"
                    android:textColor="#DDFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/pay_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_focus_primary"
                    android:focusable="true"
                    android:text="@string/pay_order_submit"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/pay_order_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/pay_key_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:hint="@string/pay_key_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters"
                    android:maxLength="24"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textColorHint="@color/hint"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/pay_submit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_focus_primary"
                    android:focusable="true"
                    android:text="@string/pay_submit"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/pay_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/pay_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_focus_primary"
                    android:focusable="true"
                    android:text="@string/pay_share_button"
                    android:textAllCaps="false"
                    android:textColor="@color/gold"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
