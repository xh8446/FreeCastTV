<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <!-- 窗口顶部居中标题 -->
    <TextView
        android:id="@+id/invite_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:text="@string/invite_share_title"
        android:textColor="@color/gold"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/invite_qr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@android:color/white"
        android:contentDescription="@string/invite_share_title"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/invite_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/invite_scan_tip"
        android:textColor="#DDFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/invite_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/hint"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/invite_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/hint"
        android:textSize="11sp" />

    <!-- 操作按钮：保存图片 / 复制链接 / 分享给好友 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/invite_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focus_primary"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/invite_save_image"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/invite_copy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focus_primary"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/invite_copy_link"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/invite_share"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focus_primary"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/invite_share_friend"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
