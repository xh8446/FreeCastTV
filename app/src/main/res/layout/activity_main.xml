<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="#00000000"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- 点按整屏（触屏模式才响应） -->
    <View
        android:id="@+id/tap_catcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false" />

    <!-- 顶部信息面板：标题、状态、倍速按钮、设置（TV 模式下移动到左下并加大字号） -->
    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶行：TV 播放时为「返回 标题 倍速- 倍速+ 设置」同一水平线；触屏仍为上下排列 -->
        <LinearLayout
            android:id="@+id/tv_top_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/info_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_speed"
                android:focusable="true"
                android:minWidth="88dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/action_back"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#DDFFFFFF"
            android:textSize="14sp" />

        <!-- 等待投屏时显示的提示（不播放时才看得到） -->
        <TextView
            android:id="@+id/hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/endpoint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <!-- 倍速按钮行（触屏模式显示，TV 模式隐藏） -->
        <LinearLayout
            android:id="@+id/touch_speed_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/speed_down"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_speed"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="− 0.25x"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/speed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="1.0x"
                android:textColor="@color/accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/speed_up"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_speed"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="+ 0.25x"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <Button
                android:id="@+id/settings_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_focus_primary"
                android:focusable="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/settings_title"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- TV 倍速徽标（独立到右上，触屏模式隐藏） -->
    <TextView
        android:id="@+id/speed_badge_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="@drawable/bg_speed"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="1.0x"
        android:textColor="@color/accent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 播放进度条（TV：遥控器左右键快进快退；触屏：拖动跳转） -->
    <LinearLayout
        android:id="@+id/progress_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/pos_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:focusable="false"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/dur_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 长按倍速提示（只在触屏模式显示） -->
    <TextView
        android:id="@+id/boost_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="88dp"
        android:alpha="0.7"
        android:background="#66000000"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 等待投屏 / 播放缓冲居中提示 -->
    <LinearLayout
        android:id="@+id/buffer_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/buffer_spinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/buffer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buffer_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/buffer_wake_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- TV 等待投屏界面可聚焦的设置按钮（放在根布局，避免父容器隐藏时无法获取焦点） -->
    <Button
        android:id="@+id/waiting_settings_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_focus_primary"
        android:focusable="true"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/settings_title"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 试用/未开通会员时的漂移水印 -->
    <TextView
        android:id="@+id/watermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="120dp"
        android:alpha="0.45"
        android:rotation="-15"
        android:text="星投屏 · 试用中"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:visibility="gone" />

</FrameLayout>
