<?xml version="1.0" encoding="utf-8"?>
<!-- 暂停/缓冲居中卡片：深色半透明 + 暖色描边，让文字更醒目 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E60D1726"
        android:endColor="#CC060B14"
        android:type="linear" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#4DFFC46B" />
</shape>
