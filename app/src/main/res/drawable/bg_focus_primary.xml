<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮焦点：琥珀金色填充 + 外描边 + 顶部高光 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#FFFFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape>
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFD166"
                        android:endColor="#FFE0A030"
                        android:type="linear" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#FFE0A030"
                android:endColor="#FFB07020"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#FFE0A030"
                android:endColor="#FFB07020"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#FFD166" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#FF1A3A80"
                android:endColor="#FF0D1E4A"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#3D7BFF" />
        </shape>
    </item>
</selector>
