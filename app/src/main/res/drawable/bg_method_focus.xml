<?xml version="1.0" encoding="utf-8"?>
<!-- 支付方式切换按钮：焦点 + 选中 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#FFD166" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape>
                    <solid android:color="#FF3D7BFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#FF3D7BFF" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#FFD166" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF1A3A6B" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#FF4C9AFF" />
        </shape>
    </item>
</selector>
