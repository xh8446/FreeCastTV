<?xml version="1.0" encoding="utf-8"?>
<!-- 倍速/返回/联系QQ按钮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#FFFFD166"
                android:endColor="#FFE0A030"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#264C8DFF"
                android:endColor="#162E66B2"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#4C8DFF" />
        </shape>
    </item>
</selector>
