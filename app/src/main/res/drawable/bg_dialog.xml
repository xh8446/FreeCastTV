<?xml version="1.0" encoding="utf-8"?>
<!-- 统一弹窗窗口背景：圆角深蓝毛玻璃，不再透明 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF1A2E52"
        android:endColor="#FF0A1630"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#4C8DFF" />
</shape>
